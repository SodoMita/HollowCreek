# Any Postgres instance. Local default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional relay for proximity voice on restrictive networks. Use short-lived
# TURN credentials and rotate them; without these, public STUN is used.
# VOICE_TURN_URL=turns:relay.example.com:5349
# VOICE_TURN_USERNAME=temporary-user
# VOICE_TURN_CREDENTIAL=temporary-password

# Optional, OFF by default: the isolated polish worker runs only when
# HOLLOW_POLISH_WORKER=1 AND HOLLOW_MAYFLY_URL is set in the server environment.
# It works on a scratch clone and reports to Mayfly; it does NOT push, deploy,
# or edit the live game. The channel URL (with its #key) is a secret: it is
# read only from this env var, never from a file in the repository.
# HOLLOW_POLISH_WORKER=0
# HOLLOW_MAYFLY_URL=https://mayfly.chat/c/YOUR_ID#YOUR_KEY
# HOLLOW_POLISH_INTERVAL_MS=1800000
