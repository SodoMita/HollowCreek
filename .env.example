# Any Postgres instance. Local default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional relay for proximity voice on restrictive networks. Use short-lived
# TURN credentials and rotate them; without these, public STUN is used.
# VOICE_TURN_URL=turns:relay.example.com:5349
# VOICE_TURN_USERNAME=temporary-user
# VOICE_TURN_CREDENTIAL=temporary-password

# Optional: start isolated small-polish worker when the production /api/health
# is called. Worker uses a local Git branch only and reports to Mayfly; it does
# NOT push, deploy, or edit the live game. Full channel URL is a secret.
# HOLLOW_POLISH_WORKER=0
# HOLLOW_MAYFLY_URL=https://mayfly.chat/c/YOUR_ID#YOUR_KEY
# HOLLOW_POLISH_INTERVAL_MS=1800000
